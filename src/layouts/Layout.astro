---
// src/layouts/Layout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Abiela Bikes | Venta y Taller de Bicicletas y Motos Eléctricas en Zipaquirá",
  description = "Especialistas en E-bikes, motos eléctricas, bicicletas de ruta y MTB. Taller profesional, mantenimiento especializado y venta de repuestos Shimano en Zipaquirá.",
  image = "/og-image.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://abiela.com.co');

// SCHEMA MULTI-NICHE: Bicicletas + Motos Eléctricas + Taller Especializado
const combinedBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["BikeShop", "MotorcycleDealer", "AutoRepair"],
  "@id": "https://abiela.com.co/#organization",
  "name": "Abiela Bikes",
  "url": "https://abiela.com.co",
  "telephone": "+573015360531", // Actualizado al número que me diste
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Cra. 19 #13-08",
    "addressLocality": "Zipaquirá",
    "addressRegion": "Cundinamarca",
    "addressCountry": "CO"
  },
  "description": "Tienda líder en Zipaquirá para la venta y mantenimiento de bicicletas de ruta, MTB y movilidad eléctrica (E-bikes y motos eléctricas).",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 5.0238,
    "longitude": -74.0028
  },
  "serviceArea": {
    "@type": "GeoCircle",
    "geoMidpoint": {
      "@type": "GeoCoordinates",
      "latitude": 5.0238,
      "longitude": -74.0028
    },
    "geoRadius": "20000" 
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Catálogo de Servicios Abiela",
    "itemListElement": [
      {
        "@type": "OfferCatalog",
        "name": "Mantenimiento y Reparación",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mantenimiento Integral MTB y Ruta" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Servicio Técnico para Bicicletas Eléctricas (E-bikes)" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Reparación de Motos Eléctricas" } }
        ]
      },
      {
        "@type": "OfferCatalog",
        "name": "Venta de Vehículos",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Bicicletas de Montaña (MTB)" } },
          { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Bicicletas de Ruta Profesionales" } },
          { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Motos Eléctricas Urbanas" } }
        ]
      }
    ]
  },
  "sameAs": [
    "https://www.facebook.com/abielazipaquirabicicleteria",
    "https://www.instagram.com/abielabike/",
    "https://www.youtube.com/@a-bielatiendaytallerbicicl2434"
  ]
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <meta name="keywords" content="motos electricas zipaquira, taller bicicletas electricas, mantenimiento MTB zipaquira, bicicletas de ruta, repuestos bicicletas electricas, e-bike shop colombia, Abiela Bikes" />

    <meta name="geo.region" content="CO-CUN" />
    <meta name="geo.placename" content="Zipaquirá" />
    <meta name="geo.position" content="5.0238;-74.0028" />
    <meta name="ICBM" content="5.0238, -74.0028" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />

    <meta name="robots" content="index, follow" />
    
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Información para IA" />
    
    <script type="application/ld+json" set:html={JSON.stringify(combinedBusinessSchema)} />
  </head>
  
  <body class="bg-brand-bg text-white antialiased min-h-screen">
    <Header />
    <main class="">
      <slot />
    </main>
    <Footer />
  </body>
</html>