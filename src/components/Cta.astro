---
import { Icon } from 'astro-icon/components';
---

<div class="mt-24 p-10 md:p-16 rounded-[3.5rem] bg-neutral-900 border border-white/10 flex flex-col md:flex-row items-center justify-between gap-12 relative overflow-hidden group shadow-2xl">
    <div class="absolute -top-24 -left-24 size-96 bg-brand-blue/10 blur-[100px] group-hover:bg-brand-blue/20 transition-colors duration-700"></div>
    <div class="absolute -bottom-24 -right-24 size-96 bg-brand-green/10 blur-[100px] group-hover:bg-brand-green/20 transition-colors duration-700"></div>

    <div class="relative z-10 text-center md:text-left max-w-xl">
        <span class="text-brand-green font-black tracking-[0.4em] text-[10px] uppercase italic mb-4 block opacity-80">Asesoría Personalizada</span>
        <h3 class="text-4xl md:text-5xl font-black italic leading-[0.9] uppercase tracking-tighter text-white">
            ¿Tienes dudas sobre <br/> 
            <span class="text-brand-blue font-outline-1">tu próxima e-bike?</span>
        </h3>
        <p class="mt-6 text-sm md:text-base font-light italic text-gray-400 uppercase tracking-widest leading-relaxed">
            Hablemos ahora <span class="mx-2 text-white/20">•</span> 
            <span class="text-white font-bold">Configuramos tu equipo según tus necesidades</span>
        </p>
    </div>

    <div class="relative z-10 flex-shrink-0">
        <a 
            href="https://wa.me/573015360531?text=Hola%20Abiela!%20👋%20Me%20gustaría%20recibir%20asesoría%20personalizada%20sobre%20sus%20bicicletas%20y%20servicios." 
            target="_blank"
            class="group/btn relative flex items-center gap-4 bg-white text-brand-dark px-10 py-5 rounded-2xl font-black uppercase tracking-[0.15em] italic text-[11px] transition-all duration-500 hover:bg-brand-green hover:scale-105 active:scale-95 shadow-[0_0_30px_rgba(255,255,255,0.1)]"
        >
            <Icon name="lucide:message-circle" class="size-5 transition-transform group-hover/btn:rotate-12" />
            Iniciar Conversación
            <div class="absolute inset-0 rounded-2xl border border-white/20 group-hover/btn:border-black/10 transition-colors"></div>
        </a>
    </div>
</div>

<style>
    .font-outline-1 {
        -webkit-text-stroke: 1px rgba(0, 119, 255, 0.5);
        color: transparent;
    }
</style>