---
import { Icon } from 'astro-icon/components';
import { eBikes } from '../data/products'; // Importamos tu data maestra
---

<div id="product-grid" class="flex md:grid overflow-x-auto md:overflow-visible snap-x snap-mandatory gap-4 md:gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 no-scrollbar pb-10">
    {eBikes.map((product) => (
        <div 
            class="product-item group relative bg-white/[0.02] border border-white/5 rounded-[2rem] overflow-hidden transition-all duration-500 flex flex-col h-full flex-shrink-0 w-[85vw] md:w-auto"
            data-price={product.priceNumber}
            data-category={product.category}
        >
            <a href={`/productos/${product.slug}`} class="block relative aspect-square overflow-hidden bg-white/5 p-2">
                <img src={product.image} alt={product.name} class="w-full h-full object-contain transition-transform duration-700 group-hover:scale-110 rounded-t-3xl hover:rounded-t-3xl" />
                {product.tag && <span class="absolute top-6 left-6 bg-brand-blue text-white text-[8px] font-black px-3 py-1 rounded-full uppercase italic tracking-widest z-10">{product.tag}</span>}
            </a>
            
            <div class="p-6 flex flex-col flex-grow">
                <a href={`/productos/${product.slug}`} class="flex-grow">
                    <h3 class="product-name text-white text-lg font-black uppercase italic leading-none mb-2 group-hover:text-brand-blue transition-colors">{product.name}</h3>
                    <p class="text-gray-500 text-xs line-clamp-2 font-light leading-relaxed">{product.description}</p>
                </a>
                
                <div class="flex items-center justify-between mt-6 pt-4 border-t border-white/5">
                    <div class="flex flex-col">
                        <span class="text-[8px] text-gray-600 uppercase font-bold tracking-widest mb-1">Precio Final</span>
                        <span class="text-xl font-black text-brand-green italic tracking-tighter leading-none">{product.price}</span>
                    </div>
                    
                    <button 
                        class="add-to-cart-btn size-11 bg-white text-brand-dark rounded-xl flex items-center justify-center hover:bg-brand-green transition-all active:scale-90"
                        data-name={product.name}
                        data-price={product.price}
                        data-img={product.image}
                        data-slug={product.slug}
                    >
                        <Icon name="lucide:shopping-cart" class="cart-icon size-5 stroke-[2.5px]" />
                        <Icon name="lucide:check" class="check-icon hidden size-6 stroke-[3px]" />
                    </button>
                </div>
            </div>
        </div>
    ))}
</div>

<div id="toast-container" class="fixed bottom-20 md:bottom-10 left-1/2 -translate-x-1/2 md:left-auto md:right-6 md:translate-x-0 z-[100] flex flex-col gap-3 pointer-events-none w-[90%] max-w-sm md:w-auto"></div>

<script>
    import { addToCart } from '../store/cartStore';

    // Función para mostrar la notificación Toast Responsive
    function showNotification(productName: string, productImg: string) {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `
            pointer-events-auto flex items-center gap-4 bg-[#0a0a0a]/90 backdrop-blur-2xl 
            border border-white/10 p-4 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] 
            transform transition-all duration-500 ease-out translate-y-full opacity-0 w-full
        `;
        
        toast.innerHTML = `
            <div class="size-14 bg-white/5 rounded-xl flex items-center justify-center shrink-0 border border-white/5 p-2">
                <img src="${productImg}" alt="${productName}" class="w-full h-full object-contain" />
            </div>
            
            <div class="flex-grow pr-2">
                <div class="flex items-center gap-2 mb-1">
                    <div class="size-4 bg-brand-green/20 rounded-full flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-2.5 text-brand-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                    <p class="text-[10px] font-black uppercase text-brand-blue italic tracking-widest mb-0">¡Excelente elección!</p>
                </div>
                <p class="text-white text-[13px] font-bold leading-snug uppercase italic mb-0.5 line-clamp-1">${productName}</p>
                <p class="text-gray-500 text-[10px] font-light italic">Se ha añadido correctamente a tu bolsa.</p>
            </div>
        `;

        container.appendChild(toast);

        setTimeout(() => {
            toast.classList.remove('translate-y-full', 'opacity-0');
        }, 10);

        setTimeout(() => {
            toast.classList.add('translate-y-full', 'opacity-0');
            setTimeout(() => toast.remove(), 500);
        }, 4000);
    }

    function initCartLogic() {
        const cartButtons = document.querySelectorAll('.add-to-cart-btn');

        cartButtons.forEach((btn) => {
            // Prevenir duplicados de eventos
            const buttonElement = btn as HTMLButtonElement;
            if (buttonElement.getAttribute('data-has-listener')) return;
            buttonElement.setAttribute('data-has-listener', 'true');

            buttonElement.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                
                const name = buttonElement.getAttribute('data-name');
                const price = buttonElement.getAttribute('data-price');
                const img = buttonElement.getAttribute('data-img');
                const slug = buttonElement.getAttribute('data-slug');

                if (name && price && img) {
                    // 🔥 SINCRONIZACIÓN TOTAL: Se envía el slug para los links de WhatsApp
                    addToCart({ 
                        name, 
                        price, 
                        img, 
                        slug: slug || ''
                    });

                    showNotification(name, img);

                    const cartIcon = buttonElement.querySelector('.cart-icon');
                    const checkIcon = buttonElement.querySelector('.check-icon');

                    if (cartIcon && checkIcon) {
                        buttonElement.classList.add('btn-success');
                        cartIcon.classList.add('hidden');
                        checkIcon.classList.remove('hidden');
                        
                        setTimeout(() => {
                            buttonElement.classList.remove('btn-success');
                            cartIcon.classList.remove('hidden');
                            checkIcon.classList.add('hidden');
                        }, 1500);
                    }
                }
            });
        });
    }

    initCartLogic();
    document.addEventListener('astro:after-swap', initCartLogic);
</script>

<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .italic { font-style: italic; }
    .product-item { will-change: transform, opacity; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
    .btn-success {
        background-color: #5fb660 !important;
        color: white !important;
        box-shadow: 0 0 15px rgba(95, 182, 96, 0.4);
    }
    .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    * { -webkit-tap-highlight-color: transparent; }
</style>