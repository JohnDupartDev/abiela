---
// src/components/Cart.astro
// Este componente no pesa nada al cargar la página
---

<button 
  id="cart-trigger" 
  class="fixed bottom-6 right-6 z-[100] size-14 md:size-16 bg-brand-green rounded-full shadow-[0_0_20px_rgba(95,182,96,0.3)] flex items-center justify-center text-brand-dark transition-transform hover:scale-110 active:scale-95"
>
    <span class="material-symbols-outlined text-3xl">shopping_basket</span>
    <div id="global-cart-count" class="absolute -top-1 -right-1 size-6 bg-brand-blue text-white text-[10px] font-black rounded-full flex items-center justify-center border-2 border-brand-dark hidden">0</div>
</button>

<div id="cart-overlay" class="fixed inset-0 z-[110] bg-brand-dark/90 backdrop-blur-md flex justify-end opacity-0 pointer-events-none transition-opacity duration-300">
    <div id="cart-aside" class="w-full max-w-md bg-brand-dark h-full border-l border-white/5 p-6 flex flex-col translate-x-full transition-transform duration-300">
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-2xl font-black italic uppercase text-white tracking-tighter">Mi <span class="text-brand-green">Pedido</span></h2>
            <button id="cart-close" class="p-2 text-white/40 hover:text-white"><span class="material-symbols-outlined">close</span></button>
        </div>

        <div id="cart-items-container" class="flex-grow overflow-y-auto space-y-4 no-scrollbar">
            </div>

        <div class="pt-6 border-t border-white/10">
            <div class="flex justify-between items-center mb-6">
                <span class="text-xs font-black uppercase text-gray-500 tracking-widest">Total</span>
                <span id="cart-total-price" class="text-3xl font-black text-brand-blue italic tracking-tighter">$0</span>
            </div>
            <button id="send-whatsapp" class="w-full bg-brand-green py-4 rounded-xl font-black text-brand-dark uppercase italic tracking-wider flex items-center justify-center gap-3 hover:bg-white transition-all group">
                Enviar pedido a WhatsApp
                <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">send</span>
            </button>
        </div>
    </div>
</div>

<script>
    import { cartItems, removeFromCart } from '../store/cartStore';

    const trigger = document.getElementById('cart-trigger');
    const overlay = document.getElementById('cart-overlay');
    const aside = document.getElementById('cart-aside');
    const close = document.getElementById('cart-close');
    const container = document.getElementById('cart-items-container');
    const totalPrice = document.getElementById('cart-total-price');
    const globalCount = document.getElementById('global-cart-count');
    const whatsappBtn = document.getElementById('send-whatsapp');

    // Función de apertura (Lazy Logic)
    const toggle = (isOpen: boolean) => {
        overlay?.classList.toggle('opacity-0', !isOpen);
        overlay?.classList.toggle('pointer-events-none', !isOpen);
        aside?.classList.toggle('translate-x-full', !isOpen);
        document.body.style.overflow = isOpen ? 'hidden' : '';
    };

    trigger?.addEventListener('click', () => toggle(true));
    close?.addEventListener('click', () => toggle(false));
    overlay?.addEventListener('click', (e) => e.target === overlay && toggle(false));

    // Suscripción ultra-ligera
    cartItems.subscribe(items => {
        const count = items.reduce((acc, i) => acc + i.quantity, 0);
        if(globalCount) {
            globalCount.innerText = count.toString();
            globalCount.classList.toggle('hidden', count === 0);
        }

        if (container) {
            container.innerHTML = items.length ? '' : '<div class="h-full flex items-center justify-center text-gray-600 italic uppercase text-xs">Carrito vacío</div>';
            
            let total = 0;
            items.forEach(item => {
                const subtotal = parseInt(item.price.replace(/\D/g, '')) * item.quantity;
                total += subtotal;

                const el = document.createElement('div');
                el.className = "bg-white/5 p-4 rounded-xl flex justify-between items-center border border-white/5 group";
                el.innerHTML = `
                    <div>
                        <p class="text-white font-bold uppercase text-sm">${item.name}</p>
                        <p class="text-brand-blue font-black text-xs italic">${item.price} x ${item.quantity}</p>
                    </div>
                    <button class="remove-btn p-2 text-white/20 hover:text-red-500 transition-colors" data-id="${item.name}">
                        <span class="material-symbols-outlined text-xl">delete_outline</span>
                    </button>
                `;
                container.appendChild(el);
            });

            if(totalPrice) totalPrice.innerText = `$${total.toLocaleString('es-CO')}`;
            
            // Event Delegation para borrar (más eficiente que muchos listeners)
            container.querySelectorAll('.remove-btn').forEach(b => {
                b.addEventListener('click', () => removeFromCart(b.getAttribute('data-id')));
            });
        }
    });

    // WhatsApp Dinámico
    whatsappBtn?.addEventListener('click', () => {
        const items = cartItems.get();
        const total = totalPrice?.innerText;
        const text = `¡Hola Abiela Bikes! 🚲\n\nQuiero agendar este pedido:\n${items.map(i => `- ${i.name} (x${i.quantity})`).join('\n')}\n\n*Total: ${total}*\n¿Me confirman disponibilidad?`;
        window.open(`https://wa.me/573213634801?text=${encodeURIComponent(text)}`, '_blank');
    });
</script>