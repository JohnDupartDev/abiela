---
import { Icon } from 'astro-icon/components';
---

<div id="cart-overlay" class="fixed inset-0 z-[110] bg-brand-dark/90 backdrop-blur-md flex justify-end opacity-0 pointer-events-none transition-opacity duration-300">
    <div id="cart-aside" class="w-full max-w-md bg-brand-dark h-full border-l border-white/5 p-6 flex flex-col translate-x-full transition-transform duration-300 shadow-2xl">
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-2xl font-black italic uppercase text-white tracking-tighter">Mi <span class="text-brand-green">Pedido</span></h2>
            <button id="cart-close" class="p-2 text-white/40 hover:text-white flex items-center justify-center transition-colors">
                <Icon name="lucide:x" class="size-8" />
            </button>
        </div>

        <div id="cart-items-container" class="flex-grow overflow-y-auto space-y-4 no-scrollbar pr-2">
            </div>

        <div class="pt-6 border-t border-white/10 bg-brand-dark">
            <div class="flex justify-between items-center mb-6 text-white">
                <span class="text-xs font-black uppercase text-gray-500 tracking-widest">Total</span>
                <span id="cart-total-price" class="text-3xl font-black text-brand-blue italic tracking-tighter">$0</span>
            </div>
            <div class="flex flex-col gap-3">
                <button id="send-whatsapp" class="w-full bg-brand-green py-4 rounded-xl font-black text-brand-dark uppercase italic tracking-wider flex items-center justify-center gap-3 hover:bg-white transition-all group shadow-lg shadow-brand-green/20">
                    Pedir por WhatsApp
                    <Icon name="lucide:send" class="size-5 group-hover:translate-x-1 transition-transform" />
                </button>
                <a href="/carrito" class="w-full py-3 text-center text-white/60 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors">
                    Ver carrito completo
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    import { cartItems, removeFromCart } from '../store/cartStore';

    const overlay = document.getElementById('cart-overlay');
    const aside = document.getElementById('cart-aside');
    const closeBtn = document.getElementById('cart-close');
    const container = document.getElementById('cart-items-container');
    const totalPrice = document.getElementById('cart-total-price');
    const whatsappBtn = document.getElementById('send-whatsapp');

    const closeCart = () => {
        overlay?.classList.add('opacity-0', 'pointer-events-none');
        aside?.classList.add('translate-x-full');
        document.body.style.overflow = '';
    };

    closeBtn?.addEventListener('click', closeCart);
    overlay?.addEventListener('click', (e) => e.target === overlay && closeCart());

    cartItems.subscribe(items => {
        if (!container) return;

        if (items.length === 0) {
            container.innerHTML = '<div class="h-full flex flex-col items-center justify-center text-gray-600 gap-4"><p class="italic uppercase text-xs tracking-widest text-center">Tu carrito está vacío</p></div>';
            if(totalPrice) totalPrice.innerText = '$0';
            return;
        }

        container.innerHTML = '';
        let total = 0;

        items.forEach((item: any) => {
            const priceNum = parseInt(item.price.replace(/\D/g, ''));
            total += priceNum * item.quantity;

            const itemImg = item.img || item.image || '/images/default-bike.jpg';

            const el = document.createElement('div');
            el.className = "bg-white/5 p-3 rounded-xl flex items-center gap-4 border border-white/5 group animate-in fade-in slide-in-from-right-4 duration-300";
            el.innerHTML = `
                <div class="size-16 flex-shrink-0 bg-white/5 rounded-lg overflow-hidden p-1 border border-white/5">
                    <img src="${itemImg}" class="w-full h-full object-contain" alt="${item.name}" />
                </div>

                <div class="flex-grow">
                    <p class="text-white font-bold uppercase text-[11px] leading-tight mb-1">${item.name}</p>
                    <p class="text-brand-blue font-black text-xs italic tracking-tighter">${item.price} <span class="text-gray-500 font-normal ml-1">x ${item.quantity}</span></p>
                </div>

                <button class="remove-btn p-2 text-white/20 hover:text-red-500 transition-colors" data-id="${item.name}">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                </button>
            `;
            container.appendChild(el);
        });

        if(totalPrice) totalPrice.innerText = `$${total.toLocaleString('es-CO')}`;
        
        container.querySelectorAll('.remove-btn').forEach(b => {
            b.addEventListener('click', () => removeFromCart(b.getAttribute('data-id')));
        });
    });

    whatsappBtn?.addEventListener('click', () => {
        const items = cartItems.get();
        if (items.length === 0) return;

        const totalValue = totalPrice?.innerText || "$0";
        const phoneNumber = "573015360531";
        
        // Obtenemos la URL base (sin el slug del producto actual)
        const baseUrl = window.location.origin;

        let message = "¡Hola Abiela Bikes! 🚲\n\n";
        message += "Quiero realizar el siguiente pedido:\n\n";
        
        items.forEach((i: any) => {
            // Construimos la URL del producto dinámicamente usando el slug guardado en el item
            const productUrl = i.slug ? `${baseUrl}/productos/${i.slug}` : baseUrl;
            
            message += `• *${i.name}* (x${i.quantity})\n`;
            message += `  Precio: ${i.price}\n`;
            message += `  Link: ${productUrl}\n\n`;
        });
        
        message += `*TOTAL ESTIMADO: ${totalValue}*\n\n`;
        message += "¿Me confirman disponibilidad y métodos de pago?";
        
        const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
        window.open(whatsappUrl, '_blank');
    });
</script>

<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>