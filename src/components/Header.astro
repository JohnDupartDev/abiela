---
import { Icon } from 'astro-icon/components';
import CartDrawer from './CartDrawer.astro';

const navLinks = [
    { name: 'Inicio', path: '/' },
    { 
        name: 'E-Bikes', 
        path: '#',
        submenu: [
            { name: 'New-York', path: '/productos/huyser-new-york', desc: 'Explora senderos con lo mejor.' },
            { name: 'Portugal', path: '/productos/huyser-portugal-2-0', desc: 'Velocidad y rendimiento puro.' },
            { name: 'Moscow', path: '/productos/huyser-moscow-2-0', desc: 'Movilidad eléctrica inteligente.' },
            { name: 'Catalogo 2026', path: '/bicicletas-electricas', desc: 'Potencia urbana sostenible.' }
        ]
    },
    { 
        name: 'Servicios', 
        path: '#',
        submenu: [
            { name: 'Mantenimiento General', path: '/servicios', desc: 'Alistamiento y limpieza.' },
            { name: 'Servicio Técnico E-Bikes', path: '/servicios', desc: 'Diagnóstico de baterías y motores.' },
            { name: 'Frenos Hidráulicos', path: '/servicios', desc: 'Purga y cambio de pastillas.' },
            { name: 'Suspensión', path: '/servicios', desc: 'Mantenimiento de horquillas.' }
        ]
    },
    { name: 'Contacto', path: '/contacto' },
];
---

<header id="navbar" class="fixed top-0 left-0 w-full flex items-center justify-between px-4 md:px-16 lg:px-24 xl:px-32 transition-all duration-500 z-50 py-3 bg-transparent border-b border-white/5">
    <a href="/" class="flex items-center z-50">
        <img src="/logo-abiela.svg" alt="Abiela Bikes Logo" class="h-16 w-auto transition-transform hover:scale(1.05) object-contain" />
    </a>

    <nav class="hidden md:flex items-center gap-4 lg:gap-8 text-white font-medium">
        {navLinks.map((link) => (
            <div class="relative group py-2">
                <a href={link.path} class="flex items-center gap-1 hover:text-brand-green transition-colors uppercase font-semibold text-sm tracking-tight">
                    {link.name}
                    {link.submenu && <Icon name="lucide:chevron-down" class="size-4 transition-transform group-hover:rotate-180" />}
                </a>
                {link.submenu && (
                    <div class="absolute top-full left-0 w-64 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300">
                        <div class="bg-brand-dark/95 border border-brand-blue/20 rounded-xl p-4 shadow-2xl backdrop-blur-xl">
                            {link.submenu.map((sub) => (
                                <a href={sub.path} class="block p-3 rounded-lg hover:bg-brand-blue/10 transition-colors group/sub">
                                    <p class="text-sm font-bold text-white group-hover/sub:text-brand-green">{sub.name}</p>
                                    <p class="text-[11px] text-gray-400 leading-tight">{sub.desc}</p>
                                </a>
                            ))}
                        </div>
                    </div>
                )}
            </div>
        ))}
    </nav>

    <div class="flex items-center gap-2 md:gap-4">
        <button id="cart-trigger" class="relative p-2 text-white hover:text-brand-green transition-all z-50 flex items-center justify-center">
            <Icon name="lucide:shopping-cart" class="size-7" />
            <div id="global-cart-count" class="absolute -top-1 -right-1 size-5 bg-brand-blue text-white text-[10px] font-black rounded-full flex items-center justify-center border-2 border-brand-dark hidden animate-bounce">
                0
            </div>
        </button>

       <div class="hidden md:block">
    <a 
        href="https://wa.me/573015360531?text=Hola%20Abiela%20Bike%20👋%20Me%20gustaría%20*agendar%20una%20visita%20al%20taller*%20para%20un%20mantenimiento%20técnico.%20¿Qué%20disponibilidad%20tienen?" 
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-2.5 rounded-full font-semibold text-white bg-brand-blue hover:bg-brand-green transition-all duration-300 shadow-lg shadow-brand-blue/20 uppercase italic text-[10px] tracking-widest inline-block active:scale-95"
    >
        Agendar Taller
    </a>
</div>

        <button id="btn-open-menu" class="text-white p-2 md:hidden z-50 flex items-center">
            <Icon name="lucide:menu" class="size-8" />
        </button>
    </div>

    <div id="mobile-menu" class="fixed top-0 left-0 w-full h-screen bg-brand-dark/98 backdrop-blur-lg flex flex-col md:hidden transition-transform duration-500 -translate-x-full z-[60] overflow-y-auto">
        <div class="p-6 flex flex-col min-h-full">
            <div class="flex justify-between items-center mb-8">
                <img src="/logo-abiela.svg" alt="Logo" class="h-10" />
                <button id="btn-close-menu" class="text-white p-2"><Icon name="lucide:x" class="size-8" /></button>
            </div>
            <div class="flex flex-col gap-4 mb-8">
                {navLinks.map((link) => (
                    <div class="mobile-nav-item">
                        <div class="flex justify-between items-center border-b border-white/5 pb-2">
                            <a href={link.path} class="text-xl font-bold text-white hover:text-brand-green py-2 transition-colors uppercase italic">{link.name}</a>
                            {link.submenu && (
                                <button class="submenu-trigger p-2 text-brand-blue transition-transform duration-300">
                                    <Icon name="lucide:chevron-down" class="size-6" />
                                </button>
                            )}
                        </div>
                        {link.submenu && (
                            <div class="submenu-content max-h-0 opacity-0 flex flex-col gap-3 ml-4 border-l border-brand-blue/30 pl-4 overflow-hidden transition-all duration-500 ease-in-out">
                                <div class="py-4 flex flex-col gap-4">
                                    {link.submenu.map((sub) => (
                                        <a href={sub.path} class="group">
                                            <p class="text-base text-white font-bold">{sub.name}</p>
                                            <p class="text-xs text-gray-500">{sub.desc}</p>
                                        </a>
                                    ))}
                                </div>
                            </div>
                        )}
                    </div>
                ))}
            </div>
            <div class="mt-auto pt-6 pb-6">
                <a href="https://wa.me/573015360531" class="flex items-center justify-center gap-2 w-full bg-brand-green py-4 rounded-xl font-black text-brand-dark uppercase italic tracking-wider transition-all active:scale-95">
                    WhatsApp Taller
                </a>
            </div>
        </div>
    </div>
</header>

<CartDrawer />

<script>
    import { cartItems } from '../store/cartStore';

    const navbar = document.getElementById('navbar');
    const trigger = document.getElementById('cart-trigger');
    const overlay = document.getElementById('cart-overlay');
    const aside = document.getElementById('cart-aside');
    const globalCount = document.getElementById('global-cart-count');

    const mobileMenu = document.getElementById('mobile-menu');
    const btnOpenMenu = document.getElementById('btn-open-menu');
    const btnCloseMenu = document.getElementById('btn-close-menu');
    const submenuTriggers = document.querySelectorAll('.submenu-trigger');

    // Abrir Carrito
    trigger?.addEventListener('click', () => {
        overlay?.classList.remove('opacity-0', 'pointer-events-none');
        aside?.classList.remove('translate-x-full');
        document.body.style.overflow = 'hidden';
    });

    // Contador del Header
    cartItems.subscribe(items => {
        const count = items.reduce((acc: any, i: { quantity: any; }) => acc + i.quantity, 0);
        if(globalCount) {
            globalCount.innerText = count.toString();
            globalCount.classList.toggle('hidden', count === 0);
        }
    });

    // Navbar Scroll
    window.addEventListener('scroll', () => {
        if (!navbar) return;
        const isScrolled = window.scrollY > 20;
        navbar.classList.toggle('bg-brand-dark/90', isScrolled);
        navbar.classList.toggle('backdrop-blur-md', isScrolled);
        navbar.classList.toggle('py-2', isScrolled);
        navbar.classList.toggle('border-brand-blue/30', isScrolled);
    });

    // Mobile Menu Triggers
    btnOpenMenu?.addEventListener('click', () => mobileMenu?.classList.remove('-translate-x-full'));
    btnCloseMenu?.addEventListener('click', () => mobileMenu?.classList.add('-translate-x-full'));

    // Lógica de Submenú Móvil Fluida
    submenuTriggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
            const container = trigger.closest('.mobile-nav-item');
            const content = container?.querySelector('.submenu-content') as HTMLElement;
            const icon = trigger.querySelector('svg');

            if (content) {
                // Verificamos si está abierto basándonos en el estilo en línea o clases
                const isOpen = content.style.maxHeight !== '0px' && content.style.maxHeight !== '';
                
                if (isOpen) {
                    content.style.maxHeight = '0px';
                    content.style.opacity = '0';
                    icon?.classList.remove('rotate-180');
                } else {
                    // Ponemos max-height igual a la altura real del contenido para una animación fluida
                    content.style.maxHeight = content.scrollHeight + 'px';
                    content.style.opacity = '1';
                    icon?.classList.add('rotate-180');
                }
            }
        });
    });
</script>

<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Estilos base para la transición del submenú móvil */
    .submenu-content {
        max-height: 0;
        opacity: 0;
        transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease-in-out;
    }

    .rotate-180 {
        transform: rotate(180deg);
    }
</style>