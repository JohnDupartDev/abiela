---
// src/components/EngineeringServices.astro
import { Icon } from 'astro-icon/components';
---

<section class="py-10 lg:py-20 bg-brand-dark overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 py-5 lg:mb-16 border-b border-white/10 lg:pb-12 mb-8">
            <div class="max-w-xl">
                <span class="text-brand-green font-black tracking-[0.3em] text-[10px] uppercase italic mb-2 block animate-fade-in">Experiencia Garantizada</span>
                <h2 class="font-black text-4xl md:text-6xl italic uppercase tracking-tighter text-white leading-none">
                    Nuestros <br class="hidden md:block"/> <span class="text-brand-blue">Servicios</span>
                </h2>
            </div>
            
            <div class="max-w-md">
                <p class="text-gray-400 text-base md:text-lg font-light leading-relaxed md:text-right">
                    Expertos en mecánica para todo tipo de bicicletas. En <span class="text-white font-bold italic">Abiela</span> cuidamos tu bicicleta tradicional o eléctrica con la mejor mano de obra de Zipaquirá.
                </p>
            </div>
        </div>

        <div class="flex md:grid overflow-x-auto md:overflow-visible snap-x snap-mandatory gap-6 md:grid-cols-2 lg:grid-cols-4 no-scrollbar pb-12 md:pb-0 items-stretch">
            
            <div class="flex-shrink-0 w-[280px] md:w-auto snap-center glass-card p-8 rounded-3xl border-b-4 border-transparent hover:border-brand-blue bg-white/5 backdrop-blur-md transition-all duration-500 group flex flex-col h-full shadow-2xl">
                <div class="w-14 h-14 rounded-2xl bg-brand-blue/10 flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-brand-blue/20 transition-all shrink-0">
                    <Icon name="lucide:settings-2" class="text-brand-blue size-8" />
                </div>
                <h4 class="text-xl font-black mb-4 italic uppercase text-white leading-tight">Mantenimiento <br/> General</h4>
                <p class="text-sm text-gray-400 leading-relaxed font-light flex-grow italic">
                    Lavado completo, engrasado de piezas y ajuste de frenos y cambios para que su bici ruede como nueva.
                </p>
            </div>

            <div class="flex-shrink-0 w-[280px] md:w-auto snap-center glass-card p-8 rounded-3xl border-b-4 border-transparent hover:border-brand-green bg-white/5 backdrop-blur-md transition-all duration-500 group flex flex-col h-full shadow-2xl">
                <div class="w-14 h-14 rounded-2xl bg-brand-green/10 flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-brand-green/20 transition-all shrink-0">
                    <Icon name="lucide:wrench" class="text-brand-green size-8" />
                </div>
                <h4 class="text-xl font-black mb-4 italic uppercase text-white leading-tight">Reparación <br/> de Piezas</h4>
                <p class="text-sm text-gray-400 leading-relaxed font-light flex-grow italic">
                    Arreglamos pinchazos, centramos rines y cambiamos repuestos desgastados con repuestos de calidad.
                </p>
            </div>

            <div class="flex-shrink-0 w-[280px] md:w-auto snap-center glass-card p-8 rounded-3xl border-b-4 border-transparent hover:border-brand-blue bg-white/5 backdrop-blur-md transition-all duration-500 group flex flex-col h-full shadow-2xl">
                <div class="w-14 h-14 rounded-2xl bg-brand-blue/10 flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-brand-blue/20 transition-all shrink-0">
                    <Icon name="lucide:cpu" class="text-brand-blue size-8" />
                </div>
                <h4 class="text-xl font-black mb-4 italic uppercase text-white leading-tight">Servicio <br/> E-Bikes</h4>
                <p class="text-sm text-gray-400 leading-relaxed font-light flex-grow italic">
                    Revisión de motores, diagnóstico de baterías y configuración de sistemas eléctricos para bicicletas modernas.
                </p>
            </div>

            <div class="flex-shrink-0 w-[280px] md:w-auto snap-center glass-card p-8 rounded-3xl border-b-4 border-transparent hover:border-brand-green bg-white/5 backdrop-blur-md transition-all duration-500 group flex flex-col h-full shadow-2xl">
                <div class="w-14 h-14 rounded-2xl bg-brand-green/10 flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-brand-green/20 transition-all shrink-0">
                    <Icon name="lucide:zap" class="text-brand-green size-8" />
                </div>
                <h4 class="text-xl font-black mb-4 italic uppercase text-white leading-tight">Alistamiento de <br/> Competencia</h4>
                <p class="text-sm text-gray-400 leading-relaxed font-light flex-grow italic">
                    Preparamos su bicicleta para carreras o rutas largas, asegurando que cada tornillo esté en su sitio.
                </p>
            </div>

        </div>
    </div>
</section>

<style>
    /* Ocultar barra de scroll para limpieza visual */
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    /* Espaciado al final del scroll horizontal para que la última card no se pegue al borde */
    @media (max-width: 767px) {
        .flex::after {
            content: '';
            min-width: 24px;
        }
    }

    .glass-card {
        /* Aseguramos que todas midan lo mismo con flex-basis o min-width en el script */
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7);
    }
    
    .animate-fade-in {
        animation: fadeIn 0.8s ease forwards;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>