---
import { Icon } from 'astro-icon/components';
---

<section class="max-w-7xl mx-auto px-6 mb-20">
    <div class="p-10 md:p-16 rounded-[3.5rem]  bg-brand-blue/20 border border-white/10 flex flex-col md:flex-row items-center justify-between gap-12 relative overflow-hidden group shadow-2xl">
        <div class="absolute -top-24 -left-24 size-96 bg-brand-blue/10 blur-[100px] group-hover:bg-brand-blue/20 transition-colors duration-700 pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 size-96 bg-brand-green/10 blur-[100px] group-hover:bg-brand-green/20 transition-colors duration-700 pointer-events-none"></div>

        <div class="relative z-10 text-center md:text-left max-w-xl">
            <span class="text-brand-green font-black tracking-[0.4em] text-[10px] uppercase italic mb-4 block opacity-80">Atención Especializada</span>
            <h2 class="text-4xl md:text-5xl font-black italic leading-[0.9] uppercase tracking-tighter text-white">
                ¿Listo para llevar tu <br/> 
                <span class="text-brand-blue font-outline-1">pasión al límite?</span>
            </h2>
            <p class="mt-6 text-sm md:text-base font-light italic text-gray-400 uppercase tracking-widest leading-relaxed">
                Hablemos hoy <span class="mx-2 text-white/20">•</span> 
                <span class="text-white font-bold">Asesoría técnica y comercial a tu medida</span>
            </p>
        </div>

        <div class="relative z-10 flex-shrink-0">
            <a 
                href="https://wa.me/573015360531?text=Hola%20Abiela!%20👋%20Me%20gustaría%20recibir%20información%20y%20asesoría%20sobre%20sus%20productos%20y%20servicios%20técnicos." 
                target="_blank"
                class="group/btn relative flex items-center gap-4 bg-white text-brand-dark px-10 py-5 rounded-2xl font-black uppercase tracking-[0.15em] italic text-[11px] transition-all duration-500 hover:bg-brand-green hover:scale-105 active:scale-95 shadow-[0_0_30px_rgba(255,255,255,0.1)]"
            >
                <Icon name="lucide:message-circle" class="size-5 transition-transform group-hover/btn:rotate-12" />
                Contactar ahora
                <div class="absolute inset-0 rounded-2xl border border-white/20 group-hover/btn:border-black/10 transition-colors"></div>
            </a>
        </div>
    </div>
</section>

<style>
    .font-outline-1 {
        -webkit-text-stroke: 1px rgba(0, 119, 255, 0.5);
        color: transparent;
    }
</style>