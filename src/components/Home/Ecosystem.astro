---
// src/components/Ecosystem.astro
import { Icon } from 'astro-icon/components';
---

<section class="py-24 px-8 max-w-7xl mx-auto bg-brand-dark text-white">
    <h2 class="font-black text-4xl md:text-5xl mb-12 text-center md:text-left italic uppercase tracking-tighter">
        Movilidad <span class="text-brand-blue">Sostenible</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 auto-rows-[280px]">
        
        <div class="md:col-span-8 md:row-span-2 rounded-2xl overflow-hidden relative group cursor-pointer border border-white/10 bg-white/5 backdrop-blur-sm">
            <img 
                class="absolute inset-0 w-full h-full object-cover opacity-20 hover:opacity-10 group-hover:scale-105 transition-transform duration-700" 
                alt="Side profile of a premium carbon fiber road bike in a professional maintenance workshop" 
                src="/images/portugal-zipa.jpg"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-transparent to-transparent"></div>
            <div class="absolute bottom-8 left-8">
                <h3 class="text-xl md:text-3xl font-black mb-2 italic uppercase">Bicicletas Eléctricas Huyser Colombia</h3>
                <p class="text-gray-400 max-w-xl font-light">
                    Distribuidores autorizados. Ofrecemos venta de bicicletas eléctricas, componentes, reparación especializada y mantenimiento integral para un rendimiento óptimo.
                </p>
            </div>
        </div>

        <div class="md:col-span-4 rounded-2xl flex flex-col justify-end p-8 border border-white/10 bg-white/5 backdrop-blur-sm group cursor-pointer hover:border-brand-blue/50 transition-all relative overflow-hidden">
            <img 
                class="absolute inset-0 w-full h-full object-cover opacity-15 group-hover:opacity-30 transition-all duration-500 rounded-2xl" 
                alt="Bicicletas tradicionales mantenimiento" 
                src="/images/bicicletas-tradicionales.jpg"
            />
            <div class="relative z-10">
                <Icon name="lucide:zap" class="text-5xl text-brand-blue mb-4 transition-transform group-hover:scale-110" />
                <h3 class="text-xl font-bold mb-1 uppercase italic">Bicicletas tradicionales</h3>
                <p class="text-sm text-gray-400 font-light">Venta, Reparación y Mantenimiento de todo tipo de bicicletas.</p>
            </div>
        </div>

        <div class="md:col-span-4 rounded-2xl flex flex-col justify-end p-8 border border-white/10 bg-white/5 backdrop-blur-sm group cursor-pointer hover:border-brand-green/50 transition-all relative overflow-hidden">
            <img 
                class="absolute inset-0 w-full h-full object-cover opacity-15 group-hover:opacity-30 transition-all duration-500 rounded-2xl" 
                alt="Motos eléctricas Zipaquirá" 
                src="/images/motos-electricas-zipaquira.jpg"
            />
            <div class="relative z-10">
                <Icon name="lucide:bike" class="text-5xl text-brand-green mb-4 transition-transform group-hover:scale-110" />
                <h3 class="text-xl font-bold mb-1 uppercase italic">Motos Eléctricas Zipaquirá</h3>
                <p class="text-sm text-gray-400 font-light">Mantenimiento preventivo y correctivo, Alistamiento, Reparación.</p>
            </div>
        </div>

        <div class="md:col-span-4 rounded-2xl overflow-hidden relative group cursor-pointer border border-white/10 bg-white/5 backdrop-blur-sm">
            <img 
                class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:scale-110 transition-all duration-500" 
                alt="Taller bicicletas Zipaquirá" 
                src="/images/taller-bicicletas-zipaquira.jpg"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 to-transparent"></div>
            <div class="absolute bottom-6 left-6">
                <h3 class="text-xl font-bold uppercase italic">Taller Especializado</h3>
                <p class="text-sm text-gray-400 font-light">Reparación y mantenimiento para todo tipo de bicicletas.</p>
            </div>
        </div>

        <div class="md:col-span-4 rounded-2xl bg-brand-blue/10 p-8 flex flex-col justify-center items-center text-center border border-brand-blue/20 group cursor-pointer hover:bg-brand-blue/20 transition-all">
            <Icon name="lucide:store" class="text-6xl text-brand-blue mb-4 transition-transform group-hover:scale-110" />
            <h3 class="text-xl font-bold mb-1 uppercase italic">Tienda Huyser</h3>
            <p class="text-sm text-gray-400 font-light uppercase tracking-widest">E-Bikes tipo Scooter</p>
        </div>

        <div class="md:col-span-4 rounded-2xl p-8 border border-white/10 bg-white/5 backdrop-blur-sm group cursor-pointer hover:border-brand-green/50 transition-all relative overflow-hidden flex flex-col justify-end min-h-[280px]">
            <img 
                class="absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-35 transition-all duration-500" 
                alt="Mantenimiento equipos de gimnasio" 
                src="/images/mantenimiento-bicicletas-gimnasio-zipaquira.jpg"
            />
            <div class="relative z-10">
                <Icon name="lucide:dumbbell" class="text-5xl text-brand-green mb-4 transition-transform group-hover:scale-110" />
                <h3 class="text-xl font-black mb-1 uppercase italic text-white">Equipos Gym</h3>
                <p class="text-sm text-gray-400 font-light">Servicio de reparación y mantenimiento técnico a domicilio.</p>
            </div>
        </div>

    </div>
</section>

<style>
    .backdrop-blur-sm {
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    /* Ocultar barra de scroll estética */
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>