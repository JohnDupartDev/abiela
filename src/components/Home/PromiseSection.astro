---
// src/components/PromiseSection.astro
---

<section class="w-full  py-24  overflow-hidden">
    <div class="max-w-[1000px] mx-auto px-4 sm:px-10 text-center">
        
        <span class="inline-block text-brand-blue font-bold tracking-[0.2em] text-xs md:text-sm uppercase mb-6 animate-fade-in-up">
            Nuestra Promesa
        </span>

        <h2 class="text-4xl md:text-5xl font-black text-white leading-[1.1] mb-8 tracking-tighter uppercase italic">
         
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-blue to-brand-green">
                confianza y respaldo
            </span> 
            para que nunca dejes de rodar.
        </h2>

        <p class="text-gray-400 text-lg md:text-xl max-w-3xl mx-auto mb-10 leading-relaxed font-light">
            Con más de <strong class="text-white font-extrabold">8 años de experiencia en Zipaquirá</strong>, entendemos que tu bicicleta es más que un medio de transporte; es tu pasión. Nos enfocamos en brindarte soluciones reales, desde el mantenimiento más sencillo hasta la electrónica compleja de tu E-bike.
        </p>

        <div class="flex justify-center items-center">
            <a 
                href="/nosotros-bicicleteria-zipaquira" 
                class="group inline-flex items-center text-brand-green font-black text-lg md:text-xl uppercase italic tracking-wider hover:text-brand-blue transition-all duration-300 gap-3"
            >
                Conoce nuestra historia
                <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    width="24" 
                    height="24" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    stroke-width="3" 
                    stroke-linecap="round" 
                    stroke-linejoin="round" 
                    class="transition-transform duration-300 transform group-hover:translate-x-3"
                >
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </a>
        </div>
    </div>
</section>

<style>
    /* Mantenemos solo esta pequeña animación personalizada si no la tienes 
       en tu tailwind.config.js, de lo contrario podrías usar animate-bounce o similares.
    */
    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>