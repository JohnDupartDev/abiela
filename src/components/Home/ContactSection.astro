---
import { Icon } from 'astro-icon/components';

const testimonials = [
    {
        name: "Juan Sebastian R.",
        text: "El mejor taller de bicis eléctricas en la zona. Repararon mi controladora que otros dieron por perdida.",
        stars: 5,
        color: "brand-green"
    },
    {
        name: "Angela M.",
        text: "Súper recomendados para el mantenimiento de gama alta. Mi MTB quedó volando y el servicio fue muy rápido.",
        stars: 5,
        color: "brand-blue"
    },
    {
        name: "Carlos T.",
        text: "Atención impecable. Se nota el conocimiento en movilidad eléctrica. Mi Huyser quedó como nueva.",
        stars: 5,
        color: "brand-green"
    },
    {
        name: "Paola G.",
        text: "Excelente ubicación y los horarios son muy cómodos para los que trabajamos hasta tarde.",
        stars: 5,
        color: "brand-blue"
    }
];

// Triplicamos para asegurar que siempre haya contenido cubriendo el área visible durante el scroll
const duplicatedReviews = [...testimonials, ...testimonials, ...testimonials];
---

<section id="ubicacion" class="max-w-7xl mx-auto py-20 bg-brand-dark overflow-hidden relative selection:bg-brand-blue/30">
    <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-brand-green/5 blur-[120px] -z-10 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col-reverse lg:grid lg:grid-cols-2 gap-16 items-center">
            
            <div class="space-y-10 w-full">
                <div>
                    <span class="text-brand-green font-black tracking-[0.4em] text-[10px] uppercase italic mb-3 block">Sede Principal</span>
                    <h2 class="font-black text-4xl md:text-6xl italic uppercase tracking-tighter text-white leading-none">
                        Visítanos en <span class="text-brand-blue">Zipaquirá</span>
                    </h2>
                </div>

                <div class="relative group aspect-video rounded-[2.5rem] overflow-hidden border border-white/10 shadow-2xl bg-[#111]">
                    <iframe 
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15256.144016565486!2d-74.01315450668335!3d5.0283074912378565!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e406ffe1a0aba1d%3A0xa4be7e78d674ba30!2sA-biela%20bicicleteria%20zipaquira!5e1!3m2!1ses-419!2sco!4v1775403200003!5m2!1ses-419!2sco" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                        class="w-full h-full contrast-125 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-700" 
                        style="border:0;" 
                        allowfullscreen="" 
                        loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade"
                    </iframe>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="glass-card-contact p-8 rounded-[2rem] border border-white/5 bg-white/[0.02] backdrop-blur-md">
                        <Icon name="lucide:map-pin" class="size-6 text-brand-blue mb-4" />
                        <h4 class="font-black italic uppercase text-white text-sm mb-2 tracking-tight">Ubicación</h4>
                        <p class="text-xs text-gray-500 leading-relaxed italic">Cra. 19 #13-08,<br/>Zipaquirá, Cundinamarca.</p>
                    </div>
                    <div class="glass-card-contact p-8 rounded-[2rem] border border-white/5 bg-white/[0.02] backdrop-blur-md">
                        <Icon name="lucide:clock" class="size-6 text-brand-green mb-4" />
                        <h4 class="font-black italic uppercase text-white text-sm mb-2 tracking-tight">Horarios</h4>
                        <p class="text-xs text-gray-500 leading-relaxed italic">Lunes a Domingo:<br/>8:00 a.m. – 8:00 p.m.</p>
                    </div>
                </div>
            </div>

            <div class="space-y-12 w-full">
                <div class="space-y-6">
                    <h3 class="font-black text-2xl italic uppercase text-white tracking-tight border-l-4 border-brand-blue pl-6">
                        Testimonios <br/> <span class="text-brand-blue">Abiela Bikes</span>
                    </h3>

                    <div class="relative h-[450px] overflow-hidden rounded-[2.5rem] border border-white/5 bg-white/[0.01]">
                        <div class="absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-brand-dark to-transparent z-20 pointer-events-none"></div>
                        <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-brand-dark to-transparent z-20 pointer-events-none"></div>

                        <div class="marquee-vertical-track flex flex-col gap-4 p-4 animate-marquee-v hover:[animation-play-state:paused]">
                            {duplicatedReviews.map((review) => (
                                <div class="p-6 rounded-3xl bg-white/[0.03] border border-white/5 relative group transition-all duration-500 hover:bg-white/[0.06] hover:border-white/10 shrink-0">
                                    <div class="flex text-brand-green gap-0.5 mb-3">
                                        {[...Array(review.stars)].map(() => <Icon name="lucide:star" class="size-2.5 fill-current" />)}
                                    </div>
                                    <p class="text-[13px] text-gray-400 italic mb-4 font-light leading-relaxed">
                                        "{review.text}"
                                    </p>
                                    <div class="text-[9px] font-black uppercase tracking-widest text-white italic">— {review.name}</div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-4">
                    <div class="aspect-square rounded-2xl overflow-hidden bg-white/5 border border-white/10 group">
                        <img class="w-full h-full object-cover opacity-50 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700" src="/images/taller-bicicletas-zipaquira.jpg" alt="Taller"/>
                    </div>
                    <div class="aspect-square rounded-2xl overflow-hidden bg-white/5 border border-white/10 group">
                        <img class="w-full h-full object-cover  opacity-50 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700" src="/images/nelson-abiela.jpg" alt="Mecánico"/>
                    </div>
                    <div class="aspect-square rounded-2xl overflow-hidden bg-white/5 border border-white/10 group">
                        <img class="w-full h-full object-cover  opacity-50 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700" src="/images/mecanico-abiela.jpg" alt="Bicicletas"/>
                    </div>
                </div>

                <a href="https://wa.me/573213634801" class="flex items-center justify-center gap-3 w-full bg-white text-brand-dark py-5 rounded-2xl font-black uppercase italic tracking-widest text-xs hover:bg-brand-green transition-all shadow-2xl active:scale-95">
                    <Icon name="lucide:message-circle" class="size-5" />
                    Agendar por WhatsApp
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .glass-card-contact {
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
    }

    /* Animación Vertical Marquee */
    .animate-marquee-v {
        animation: scroll-v 25s linear infinite;
    }

    /* El truco es mover exactamente 1/3 de la altura total del track porque triplicamos los items */
    @keyframes scroll-v {
        0% { transform: translateY(0); }
        100% { transform: translateY(calc(-33.33% - 0.65rem)); } /* Ajuste fino del gap */
    }

    iframe { background: #000; }
</style>