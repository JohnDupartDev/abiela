                        <div class="border-b border-white/5 pb-1">Factura Nº: <span class="text-white">___________________________</span></div>
                        <div class="border-b border-white/5 pb-1">Comercializador: <span class="text-white">___________________________</span></div>
                    </div>
                    
                    <div class="mt-10 pt-10 border-t border-white/5">
                         <h4 class="text-white text-xs mb-6 text-center">INFORMACIÓN DEL COMPRADOR / PROPIETARIO</h4>
                         <div class="grid md:grid-cols-2 gap-x-12 gap-y-6 text-[10px] uppercase font-black tracking-widest text-gray-500">
                            <div class="border-b border-white/5 pb-1">Nombre: <span class="text-white">___________________________</span></div>
                            <div class="border-b border-white/5 pb-1">Cédula: <span class="text-white">___________________________</span></div>
                            <div class="border-b border-white/5 pb-1">Ciudad: <span class="text-white">___________________________</span></div>
